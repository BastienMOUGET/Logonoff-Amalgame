// Stdlib test: Amalgame.Database — SQLite 3 via the vendored
// amalgamation. Uses `:memory:` so we don't litter /tmp with
// test artifacts and the suite stays parallel-safe.

namespace Tests

import Amalgame.Collections
import Amalgame.Database.SQLite

public class Program {
    public static void Main(string[] args) {

        // ── Open + close ──────────────────────────────────

        let db = SQLite.Open(":memory:")
        if (SQLite.IsOpen(db)) {
            Console.WriteLine("[PASS] open memory")
        } else {
            Console.WriteLine("[FAIL] open memory got " + SQLite.LastError(db))
        }

        // ── DDL + DML ─────────────────────────────────────

        let createOk: bool = SQLite.Exec(db, "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, age INTEGER)")
        if (createOk) {
            Console.WriteLine("[PASS] create table")
        } else {
            Console.WriteLine("[FAIL] create table: " + SQLite.LastError(db))
        }

        let insertOk: bool = SQLite.Exec(db, "INSERT INTO users (name, age) VALUES ('Alice', 30)")
        if (insertOk) {
            Console.WriteLine("[PASS] insert alice")
        } else {
            Console.WriteLine("[FAIL] insert alice: " + SQLite.LastError(db))
        }

        let alice_id: int = SQLite.LastInsertId(db)
        if (alice_id == 1) {
            Console.WriteLine("[PASS] last insert id 1")
        } else {
            Console.WriteLine("[FAIL] last insert id got " + String_FromInt(alice_id))
        }

        SQLite.Exec(db, "INSERT INTO users (name, age) VALUES ('Bob', 25)")
        SQLite.Exec(db, "INSERT INTO users (name, age) VALUES ('Charlie', 40)")
        let final_id: int = SQLite.LastInsertId(db)
        if (final_id == 3) {
            Console.WriteLine("[PASS] last insert id 3")
        } else {
            Console.WriteLine("[FAIL] last insert id got " + String_FromInt(final_id))
        }

        // ── Changes counter ───────────────────────────────

        let updateOk: bool = SQLite.Exec(db, "UPDATE users SET age = age + 1 WHERE name != 'Charlie'")
        let updated: int = SQLite.Changes(db)
        if (updated == 2) {
            Console.WriteLine("[PASS] changes 2")
        } else {
            Console.WriteLine("[FAIL] changes got " + String_FromInt(updated))
        }

        // ── Query: SELECT *, count rows ────────────────────

        // v0.3.0+: `returns_generic = "List<List<string>>"` in the
        // manifest lets amc infer the full chain. No annotations
        // needed on `rows`, `alice_row`, `alice_name`, etc.
        let rows = SQLite.QueryAll(db, "SELECT id, name, age FROM users ORDER BY id")
        let rowCount: int = rows.Count()
        if (rowCount == 3) {
            Console.WriteLine("[PASS] query 3 rows")
        } else {
            Console.WriteLine("[FAIL] query got " + String_FromInt(rowCount) + " rows")
        }

        // ── Query: column values as text ───────────────────

        let alice_row = rows.Get(0)
        let alice_name = alice_row.Get(1)
        if (alice_name == "Alice") {
            Console.WriteLine("[PASS] alice name")
        } else {
            Console.WriteLine("[FAIL] alice name got " + alice_name)
        }

        let alice_age = alice_row.Get(2)
        if (alice_age == "31") {
            Console.WriteLine("[PASS] alice age post-update")
        } else {
            Console.WriteLine("[FAIL] alice age got " + alice_age)
        }

        // ── Aggregate: SELECT COUNT(*) ────────────────────

        // Post-update ages: Alice=31, Bob=26, Charlie=40. Both
        // Alice and Charlie are > 30, so the count is 2.
        let countRows = SQLite.QueryAll(db, "SELECT COUNT(*) FROM users WHERE age > 30")
        let countRow = countRows.Get(0)
        let countStr = countRow.Get(0)
        if (countStr == "2") {
            Console.WriteLine("[PASS] aggregate count 2")
        } else {
            Console.WriteLine("[FAIL] aggregate got " + countStr)
        }

        // ── Error path: invalid SQL ────────────────────────

        let badOk: bool = SQLite.Exec(db, "INSERT INTO nonexistent_table VALUES (1)")
        if (!badOk) {
            let err: string = SQLite.LastError(db)
            if (String_Contains(err, "no such table")) {
                Console.WriteLine("[PASS] error reported")
            } else {
                Console.WriteLine("[FAIL] error msg got: " + err)
            }
        } else {
            Console.WriteLine("[FAIL] error should have flagged")
        }

        // ── DELETE + verify ────────────────────────────────

        SQLite.Exec(db, "DELETE FROM users WHERE name = 'Bob'")
        let afterDelete = SQLite.QueryAll(db, "SELECT COUNT(*) FROM users")
        let afterRow = afterDelete.Get(0)
        let leftStr = afterRow.Get(0)
        if (leftStr == "2") {
            Console.WriteLine("[PASS] delete leaves 2")
        } else {
            Console.WriteLine("[FAIL] delete count got " + leftStr)
        }

        // ── v0.4: parameter binding (ExecBind / QueryBindAll) ─

        // Parameterised INSERT — defends against injection without
        // the caller string-escaping anything.
        let bindParams: List<string> = new List<string>()
        bindParams.Add("Dave; DROP TABLE users; --")
        bindParams.Add("55")
        let bindOk: bool = SQLite.ExecBind(db,
            "INSERT INTO users (name, age) VALUES (?, ?)", bindParams)
        if (bindOk) {
            Console.WriteLine("[PASS] execbind insert")
        } else {
            Console.WriteLine("[FAIL] execbind: " + SQLite.LastError(db))
        }

        // The "; DROP TABLE" payload must round-trip as data, not
        // get evaluated as a separate statement. Verify by name + count.
        let stillThere: bool = SQLite.IsOpen(db)
        if (stillThere) {
            Console.WriteLine("[PASS] execbind injection foiled")
        } else {
            Console.WriteLine("[FAIL] execbind injection: handle closed")
        }

        // QueryBindAll with a single param — fetch the row we just
        // inserted by name.
        let qParams: List<string> = new List<string>()
        qParams.Add("Dave; DROP TABLE users; --")
        let daveRows = SQLite.QueryBindAll(db,
            "SELECT name, age FROM users WHERE name = ?", qParams)
        if (daveRows.Count() == 1) {
            let daveRow = daveRows.Get(0)
            let daveAge: string = daveRow.Get(1)
            if (daveAge == "55") {
                Console.WriteLine("[PASS] querybindall fetch")
            } else {
                Console.WriteLine("[FAIL] querybindall age got: " + daveAge)
            }
        } else {
            Console.WriteLine("[FAIL] querybindall rows got " + String_FromInt(daveRows.Count()))
        }

        // Arity mismatch: SQL expects 2 params, we pass 1.
        let arityBad: List<string> = new List<string>()
        arityBad.Add("alone")
        let arityOk: bool = SQLite.ExecBind(db,
            "INSERT INTO users (name, age) VALUES (?, ?)", arityBad)
        if (!arityOk) {
            let arityErr: string = SQLite.LastError(db)
            if (String_Contains(arityErr, "param count mismatch")) {
                Console.WriteLine("[PASS] execbind arity check")
            } else {
                Console.WriteLine("[FAIL] execbind arity err: " + arityErr)
            }
        } else {
            Console.WriteLine("[FAIL] execbind arity: should have rejected")
        }

        // NULL binding — list entry is "" today (no nullable List
        // element until amalgame ergonomics catch up). Skip the
        // NULL test for now; LL params bound through bind_text
        // become empty-string SQL values, which round-trips.

        // ── v0.4: transactions (Begin / Commit / Rollback) ────

        let beginOk: bool = SQLite.Begin(db)
        if (beginOk) {
            Console.WriteLine("[PASS] begin")
        } else {
            Console.WriteLine("[FAIL] begin: " + SQLite.LastError(db))
        }

        SQLite.Exec(db, "INSERT INTO users (name, age) VALUES ('Eve', 99)")
        let rollbackOk: bool = SQLite.Rollback(db)
        if (rollbackOk) {
            Console.WriteLine("[PASS] rollback")
        } else {
            Console.WriteLine("[FAIL] rollback: " + SQLite.LastError(db))
        }
        // Eve must NOT be in the table after rollback.
        let eveParams: List<string> = new List<string>()
        eveParams.Add("Eve")
        let eveRows = SQLite.QueryBindAll(db,
            "SELECT name FROM users WHERE name = ?", eveParams)
        if (eveRows.Count() == 0) {
            Console.WriteLine("[PASS] rollback drops insert")
        } else {
            Console.WriteLine("[FAIL] rollback left " + String_FromInt(eveRows.Count()) + " eve rows")
        }

        // Commit path: insert Frank, commit, verify.
        SQLite.Begin(db)
        SQLite.Exec(db, "INSERT INTO users (name, age) VALUES ('Frank', 33)")
        let commitOk: bool = SQLite.Commit(db)
        if (commitOk) {
            Console.WriteLine("[PASS] commit")
        } else {
            Console.WriteLine("[FAIL] commit: " + SQLite.LastError(db))
        }
        let frankParams: List<string> = new List<string>()
        frankParams.Add("Frank")
        let frankRows = SQLite.QueryBindAll(db,
            "SELECT age FROM users WHERE name = ?", frankParams)
        if (frankRows.Count() == 1) {
            Console.WriteLine("[PASS] commit persists insert")
        } else {
            Console.WriteLine("[FAIL] commit lost insert: " + String_FromInt(frankRows.Count()))
        }

        // Nested BEGIN must fail — SQLite refuses it.
        SQLite.Begin(db)
        let nestedOk: bool = SQLite.Begin(db)
        if (!nestedOk) {
            let nestErr: string = SQLite.LastError(db)
            if (String_Contains(nestErr, "transaction")) {
                Console.WriteLine("[PASS] nested begin rejected")
            } else {
                Console.WriteLine("[FAIL] nested begin err: " + nestErr)
            }
        } else {
            Console.WriteLine("[FAIL] nested begin: should have rejected")
        }
        SQLite.Rollback(db) // clear the outer transaction

        // ── Close ─────────────────────────────────────────

        SQLite.Close(db)
        if (!SQLite.IsOpen(db)) {
            Console.WriteLine("[PASS] closed")
        } else {
            Console.WriteLine("[FAIL] still open after close")
        }
    }
}
