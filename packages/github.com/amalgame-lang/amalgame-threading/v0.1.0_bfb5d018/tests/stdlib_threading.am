// Stdlib test: Amalgame.Threading — Mutex + Channel + Thread.
// Self-contained, no external service. Exercises:
//   - Mutex lock/unlock + trylock
//   - Channel send/receive (single-threaded blocking-friendly)
//   - Channel close + drain semantics
//   - Thread.Spawn + Thread.Join with real concurrency
//   - Thread.Sleep
//   - Producer-consumer pattern via Channel from a spawned thread

namespace Tests

import Amalgame.Threading

public class Program {
    public static void Main(string[] args) {

        // ── Mutex round-trip ─────────────────────────────────
        let m = Threading.MutexNew()
        Threading.MutexLock(m)
        // Already locked — trylock should fail.
        // (Skipping the trylock-fails-when-held test here because
        // pthread_mutex_trylock on a self-held non-recursive
        // mutex is undefined behaviour on Linux; just exercise
        // the API.)
        Threading.MutexUnlock(m)
        let got: bool = Threading.MutexTryLock(m)
        if (got) {
            Threading.MutexUnlock(m)
            Console.WriteLine("[PASS] Mutex lock/unlock + trylock")
        } else {
            Console.WriteLine("[FAIL] Mutex TryLock returned false on free mutex")
        }

        // ── Channel single-thread round-trip ─────────────────
        let ch = Threading.ChannelNew(4)
        Threading.ChannelSend(ch, 10)
        Threading.ChannelSend(ch, 20)
        Threading.ChannelSend(ch, 30)
        if (Threading.ChannelCount(ch) == 3) {
            Console.WriteLine("[PASS] Channel Count == 3")
        } else {
            Console.WriteLine("[FAIL] Channel Count = "
                + String_FromInt(Threading.ChannelCount(ch)))
        }
        let a: int = Threading.ChannelReceive(ch)
        let b: int = Threading.ChannelReceive(ch)
        let c: int = Threading.ChannelReceive(ch)
        if (a == 10 && b == 20 && c == 30) {
            Console.WriteLine("[PASS] Channel FIFO order")
        } else {
            Console.WriteLine("[FAIL] Channel got " + String_FromInt(a)
                + "/" + String_FromInt(b) + "/" + String_FromInt(c))
        }

        // ── TrySend / TryReceive on empty / full ─────────────
        let okSend: bool = Threading.ChannelTrySend(ch, 99)
        let dropped: int = Threading.ChannelTryReceive(ch)
        if (okSend && dropped == 99) {
            Console.WriteLine("[PASS] TrySend/TryReceive round-trip")
        } else {
            // No ternary in AM — branch the error message instead.
            if (!okSend) {
                Console.WriteLine("[FAIL] TrySend returned false")
            } else {
                Console.WriteLine("[FAIL] TryReceive got " + String_FromInt(dropped))
            }
        }
        // Empty now — TryReceive returns 0 sentinel.
        let nothing: int = Threading.ChannelTryReceive(ch)
        if (nothing == 0) {
            Console.WriteLine("[PASS] TryReceive on empty returns 0")
        } else {
            Console.WriteLine("[FAIL] empty TryReceive = " + String_FromInt(nothing))
        }

        // ── Channel close + drain ────────────────────────────
        Threading.ChannelSend(ch, 7)
        Threading.ChannelClose(ch)
        if (Threading.ChannelIsClosed(ch)) {
            Console.WriteLine("[PASS] ChannelClose")
        } else {
            Console.WriteLine("[FAIL] still open after Close")
        }
        // Closed but non-empty: Receive returns the buffered 7,
        // then 0 sentinel on subsequent calls.
        let drainOne: int = Threading.ChannelReceive(ch)
        let drainTwo: int = Threading.ChannelReceive(ch)
        if (drainOne == 7 && drainTwo == 0) {
            Console.WriteLine("[PASS] Receive drains then sentinels")
        } else {
            Console.WriteLine("[FAIL] drain got " + String_FromInt(drainOne)
                + " then " + String_FromInt(drainTwo))
        }

        // ── Thread.Sleep ─────────────────────────────────────
        // Smoke only — we don't depend on amalgame-datetime so
        // there's no clock to verify the elapsed time. The call
        // returning at all means nanosleep didn't EINTR-loop or
        // crash; the actual duration is exercised implicitly by
        // the producer-consumer test below (workers pause-free).
        Threading.ThreadSleep(50)
        Console.WriteLine("[PASS] Thread.Sleep returns cleanly")

        // ── Spawn a worker that writes to a channel ──────────
        let workCh = Threading.ChannelNew(8)
        let worker = (id: int) => {
            // Write 5 values then close
            var i: int = 0
            while (i < 5) {
                Threading.ChannelSend(workCh, id * 100 + i)
                i = i + 1
            }
            Threading.ChannelClose(workCh)
            return 0
        }
        let t = Threading.ThreadSpawn(worker, 42)
        // Consume in main thread
        var sum: int = 0
        var count: int = 0
        while (true) {
            let v: int = Threading.ChannelReceive(workCh)
            if (Threading.ChannelIsClosed(workCh) && Threading.ChannelCount(workCh) == 0 && v == 0) {
                break
            }
            sum = sum + v
            count = count + 1
            if (count > 100) { break }
        }
        Threading.ThreadJoin(t)
        // 42*100*5 + (0+1+2+3+4) = 21000 + 10 = 21010
        if (count == 5 && sum == 21010) {
            Console.WriteLine("[PASS] worker thread + channel consumed 5 values")
        } else {
            Console.WriteLine("[FAIL] count=" + String_FromInt(count)
                + " sum=" + String_FromInt(sum))
        }

        // ── 4 producer threads + 1 consumer ──────────────────
        // Demonstrates multi-threaded contention on a single
        // channel — every thread sends 10 values, consumer sums.
        let bigCh = Threading.ChannelNew(16)
        let producer = (pid: int) => {
            var k: int = 0
            while (k < 10) {
                Threading.ChannelSend(bigCh, 1)
                k = k + 1
            }
            return 0
        }
        let t1 = Threading.ThreadSpawn(producer, 1)
        let t2 = Threading.ThreadSpawn(producer, 2)
        let t3 = Threading.ThreadSpawn(producer, 3)
        let t4 = Threading.ThreadSpawn(producer, 4)
        // Consume 40 values
        var total: int = 0
        var pulled: int = 0
        while (pulled < 40) {
            total = total + Threading.ChannelReceive(bigCh)
            pulled = pulled + 1
        }
        Threading.ThreadJoin(t1)
        Threading.ThreadJoin(t2)
        Threading.ThreadJoin(t3)
        Threading.ThreadJoin(t4)
        Threading.ChannelClose(bigCh)
        if (total == 40) {
            Console.WriteLine("[PASS] 4 producers x 10 sends consumed correctly")
        } else {
            Console.WriteLine("[FAIL] multi-producer total=" + String_FromInt(total))
        }
    }
}
